"CFBundleDisplayName" = "DesktopDance";
"NSHumanReadableCopyright" = "Copyright © 2026 Jennifer Fang. Noncommercial use only.";
"NSDesktopFolderUsageDescription" = "DesktopDance reads which files are on your desktop so it can animate copies of their icons. It only reads icons and names and never changes any file.";
